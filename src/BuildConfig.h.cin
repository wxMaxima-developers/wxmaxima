/*! \file
  Compile-time build configuration, generated from BuildConfig.h.cin by CMake.

  Holds the feature/option defines selected at configure time plus the install
  prefix. These are stable across commits (they only change when the build options
  change), so this header can safely sit in the precompiled header. The
  per-commit git hash deliberately does NOT live here (see GitHash.cpp /
  WxMaximaGitShortHash() in Version.h).
*/

#ifndef WXM_BUILDCONFIG_H
#define WXM_BUILDCONFIG_H

// A raw string literal, so that a prefix containing a quote or a backslash
// needs no escaping (GH #1347). UTF-8, like every source file.
#define CMAKE_INSTALL_PREFIX R"wxmprefix(@CMAKE_INSTALL_PREFIX@)wxmprefix"
#cmakedefine USE_PRECOMP_HEADER
#cmakedefine USE_WEBVIEW
#cmakedefine USE_QA
#cmakedefine WXM_USE_AI_TOOLS
#cmakedefine USE_FRIBIDI
// The PDF export, see cmake/WxmPdfDoc.cmake
#cmakedefine WXM_USE_WXPDFDOC
// Why there is no PDF export (empty if there is one), shown by Help >
// Troubleshooting. English, like the rest of the configure output.
#define WXM_WXPDFDOC_MISSING_REASON R"wxmreason(@WXM_WXPDFDOC_MISSING_REASON@)wxmreason"

#endif // WXM_BUILDCONFIG_H
