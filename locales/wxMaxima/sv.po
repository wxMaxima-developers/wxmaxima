#: ../../src/dialogs/TipOfTheDay.cpp:59
msgid ""
"Maxima uses ':' to assign values to a variable ('a : 3;'), not '=' as most "
"programming languages do.\n"
"This allows, that a mathematical equation can be assigned to a variable, "
"e.g.\n"
" eq1:3*x=4;\n"
"which may then be solved for x with\n"
"solve(eq1,x);"
msgstr ""
