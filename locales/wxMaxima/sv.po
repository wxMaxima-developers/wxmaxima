#: ../../src/dialogs/TipOfTheDay.cpp:175
msgid ""
"In order to visualize how a parameter affects an equation wxMaxima provides "
"commands that start with \"with_slider_\" and that create animations. One "
"example would be:\n"
"\n"
"    with_slider_draw(\n"
"        a,[-16,-9,-4,-2,0,1,2,3,4,5,6,7],\n"
"        title=concat(\"a=\",a),\n"
"        grid=true,\n"
"        explicit(\n"
"            x^2-a*x,\n"
"            x,-10,10\n"
"        )\n"
"    );"
msgstr ""
"För att visa hur en parameter påverkar en ekvation erbjuder wxMaxima "
"kommandon som börjar med ”with_slider_” och skapar animeringar. Ett exempel "
"är:\n"
"\n"
"    with_slider_draw(\n"
"        a,[-16,-9,-4,-2,0,1,2,3,4,5,6,7],\n"
"        title=concat(\"a=\",a),\n"
"        grid=true,\n"
"        explicit(\n"
"            x^2-a*x,\n"
"            x,-10,10\n"
"        )\n"
"    );"

