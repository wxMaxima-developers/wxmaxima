"<kbd>CTRL</kbd>+<kbd>SHIFT</kbd>+<kbd>TAB</kbd> triggers the auto-completion"
" mechanism."
msgstr ""
"<kbd> CTRL </kbd> + <kbd> ÜST KARAKTER </kbd> + <kbd> SİL </kbd> tam bir "
"hücreyi siler."

#. type: Bullet: '- '
#: ../../info/wxmaxima.md:276
