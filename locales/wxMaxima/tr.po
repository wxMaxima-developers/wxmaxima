#, fuzzy
#| msgid "### .wxm"
msgid "### .wxm"
msgstr "### .wxm"

#. type: Plain text
#: ../../info/wxmaxima.md:302
#, fuzzy
#| msgid ""
#| ".wxm files contains the worksheet except _Maxima_'s output. On Maxima "
