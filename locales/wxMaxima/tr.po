#: ../../info/wxmaxima.md:818
#, fuzzy, no-wrap
#| msgid ""
#| "    table_form(\n"
#| "        [\n"
#| "            [1,2],\n"
#| "            [3,4]\n"
#| "        ]\n"
#| "    )$\n"
msgid ""
"```maxima\n"
"table_form(\n"
"    [\n"
"        [1,2],\n"
"        [3,4]\n"
"    ]\n"
")$\n"
"```\n"
msgstr ""
"    table_form(\n"
"        [\n"
"            [1,2],\n"
"            [3,4]\n"
"        ]\n"
"    )$\n"

