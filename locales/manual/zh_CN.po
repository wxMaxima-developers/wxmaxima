#. type: Plain text
#: ../../info/wxmaxima.md:1138
msgid "If no frontend is used (you are using command line Maxima), these variables are `false`."
msgstr ""

#. type: Title ##
#: ../../info/wxmaxima.md:1139
#, no-wrap
msgid "Help! I can not save my document!"
msgstr ""

#. type: Plain text
