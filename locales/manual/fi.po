#. type: Bullet: '- '
#: ../../info/wxmaxima.md:63
#, fuzzy
msgid "Image cells."
msgstr "Yhdistä solut"

#. type: Bullet: '- '
#: ../../info/wxmaxima.md:63
msgid "Text cells, that can for example be used for documentation."
msgstr ""

#. type: Bullet: '- '
#: ../../info/wxmaxima.md:63
msgid "A title, section or a subsection. 6 levels of different headings are possible."
