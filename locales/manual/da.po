#, fuzzy, no-wrap
msgid "Cells"
msgstr "&Slet celle(r)"

#. type: Plain text
#: ../../info/wxmaxima.md:56
msgid "The worksheet is organized in cells. WxMaxima knows the following cell types:"
msgstr ""

#. type: Bullet: '- '
