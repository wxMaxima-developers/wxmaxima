"pngdraw(name,[contents]):=\n"
"(\n"
"    draw(\n"
"        append(\n"
"            [\n"
"                terminal=pngcairo,\n"
"                dimensions=wxplot_size,\n"
"                file_name=name\n"
"            ],\n"
"            contents\n"
"        )\n"
"    ),\n"
"    show_image(printf(false,\"~a.png\",name))\n"
");\n"
