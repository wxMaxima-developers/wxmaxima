msgstr ""

#. type: Bullet: '- '
#: ../../info/wxmaxima.md:78
msgid "A vertical cursor that works inside a cell. This cursor is activated by moving the cursor inside a cell using the mouse pointer or the cursor keys and works much like the cursor in a text editor."
msgstr ""

#. type: Plain text
